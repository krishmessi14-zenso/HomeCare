# Copy this file to .env and replace the placeholders. NEVER commit .env.
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/
# MongoDB Atlas example (use your own user/password/cluster):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/homecare?retryWrites=true&w=majority
SECRET_KEY=replace_with_a_secure_random_secret

# Optional
# MONGO_DB_NAME=homecare
# COOKIE_SECURE=true     # set to true when served over HTTPS
# HOST=127.0.0.1
# PORT=5000
